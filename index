<script>
(function () {
  // armazenamento com fallback em memória (caso o navegador bloqueie)
  var mem = {};
  function save(k, v) { try { localStorage.setItem('ifes12_' + k, v); } catch (e) { mem[k] = v; } }
  function load(k) { try { return localStorage.getItem('ifes12_' + k); } catch (e) { return mem[k] || null; } }

  var checks = document.querySelectorAll('.dia input[type=checkbox]');
  var inputs = document.querySelectorAll('input.mini');
  var TOTAL = checks.length;

  function frase(p) {
    if (p === 0) return ['Vamos começar! 🚀', ''];
    if (p < 25) return ['Bom começo! 🌱', ''];
    if (p < 50) return ['Ganhando ritmo! 🔥', ''];
    if (p < 75) return ['Mais da metade! 💪', ''];
    if (p < 100) return ['Reta final! 🏁', ''];
    return ['Plano concluído! 🏆', ''];
  }

  function atualizar() {
    var feitos = 0;
    var porSemana = {};
    checks.forEach(function (c) {
      var w = c.dataset.week;
      porSemana[w] = porSemana[w] || { t: 0, f: 0 };
      porSemana[w].t++;
      if (c.checked) { feitos++; porSemana[w].f++; }
    });
    var pct = Math.round(100 * feitos / TOTAL);
    document.getElementById('pct-geral').textContent = pct + '%';
    document.getElementById('anel-fill').style.strokeDashoffset = (226.2 * (1 - feitos / TOTAL)).toFixed(1);
    document.getElementById('msg-titulo').textContent = frase(pct)[0];
    document.getElementById('msg-detalhe').textContent = feitos + ' de ' + TOTAL + ' sessões de estudo concluídas.' + (pct < 100 ? ' Continue firme!' : ' Parabéns, agora é só manter a revisão leve até a prova!');
    Object.keys(porSemana).forEach(function (w) {
      var el = document.getElementById('prog-txt-' + w);
      var fill = document.getElementById('prog-fill-' + w);
      if (el) el.textContent = porSemana[w].f + '/' + porSemana[w].t;
      if (fill) fill.style.width = (100 * porSemana[w].f / porSemana[w].t) + '%';
    });
  }

  checks.forEach(function (c) {
    if (load(c.id) === '1') c.checked = true;
    c.addEventListener('change', function () { save(c.id, c.checked ? '1' : '0'); atualizar(); });
  });
  inputs.forEach(function (i) {
    var v = load('sim_' + i.dataset.sim);
    if (v) i.value = v;
    i.addEventListener('input', function () { save('sim_' + i.dataset.sim, i.value); });
  });
  // abre a primeira semana incompleta
  atualizar();
  for (var w = 1; w <= 12; w++) {
    var txt = document.getElementById('prog-txt-' + w);
    if (txt && txt.textContent.split('/')[0] !== txt.textContent.split('/')[1]) {
      var det = document.getElementById('semana-' + w);
      if (det) det.open = true;
      break;
    }
  }
})();
</script>
